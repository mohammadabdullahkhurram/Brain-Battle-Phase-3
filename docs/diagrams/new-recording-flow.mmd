flowchart TD
    Start(["Press<br/>'New recording'"]) --> Ready["Step 1 · Get ready<br/>checklist, codes,<br/>colours, plan"]
    Ready -->|"Test timing"| Buzzer["Buzzer test:<br/>5 beeps, both boxers<br/>tap their headband"]
    Buzzer -->|"corrections<br/>kept"| Ready
    Ready -->|"something<br/>not green"| Fix["Start stays off:<br/>'Fix N things<br/>above to start'"]
    Fix --> Ready
    Ready -->|"Start recording"| Lead["Recording starts:<br/>15 s lead-in"]
    Lead --> Rounds["Baseline, rounds,<br/>breaks — marked<br/>automatically;<br/>bell at both ends<br/>of every round"]
    Rounds -->|"M"| Moment["Moment + note<br/>(Save note / later);<br/>nothing pauses"]
    Moment --> Rounds
    Rounds -->|"camera stalls /<br/>headband drops"| Recover["Reopened /<br/>Reconnect —<br/>same files"]
    Recover --> Rounds
    Rounds -->|"finishes or<br/>Stop recording"| Saved["Step 3 · Saved<br/>timing result,<br/>worth checking"]
    Saved --> Label["Start labelling<br/>(Review &amp; Label)"]
    Saved --> Another["Record<br/>another"]
